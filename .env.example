# Copiar este archivo a ".env" y completar con las keys reales.
# NUNCA subir el archivo ".env" real a git.

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# AbuseIPDB (reputación de IPs) — https://www.abuseipdb.com/register
# Opcional: sin key, check_ip_reputation() usa un fallback heurístico local.
ABUSEIPDB_API_KEY=

# NVD (consulta de CVEs) — https://nvd.nist.gov/developers/request-an-api-key
# Opcional: funciona sin key pero con rate limit muy bajo.
NVD_API_KEY=

# --- Motor LLM ---
# gemini-2.5-pro es lo que especifica el Informe de Seminario (fuente de verdad).
# PERO: la familia 2.5 completa (pro, flash, flash-lite) devuelve 404 "no
# longer available to new users" -- confirmado dos veces (23-ago-2026 en tier
# gratuito, 1-sep-2026 con cuenta YA PAGADA): es un límite de capacidad por
# antigüedad de cuenta, no de facturación. Pagar no lo desbloquea. Ver README,
# sección "Modelo LLM en la práctica".
#
# Decisión final (1-sep-2026, con cuenta pagada y 6 corridas reales de
# medición): dos modelos, uno principal y uno de respaldo automático (ver
# `_generate_con_fallback` en src/llm.py). El sistema llama primero al
# principal; si agota sus reintentos por cuota o un error transitorio,
# reintenta solo con el de respaldo antes de darse por vencido.
#   - LLM_MODEL_PRIMARY: mejor calidad/estabilidad medida (0 fallas en 2
#     corridas reales, confianza 0.95), pero ~3.4x más caro.
#   - LLM_MODEL_FALLBACK: 0 fallas en 4 corridas reales, confianza
#     0.90-0.95, notablemente más barato -- lo usa el sistema si el
#     principal no responde o se queda sin cuota.
# gemini-3.7-flash (el default de antes de esta decisión) quedó descartado:
# fue el único modelo que falló en las pruebas reales de esta ronda (86s de
# latencia en un prompt trivial, tras un 503 de 64s). Evita alias
# "-latest": pueden apuntar a un modelo distinto sin aviso, lo que rompe
# reproducibilidad.
#
# Tier gratuito vs. pagado: Antonia activó facturación (1-sep-2026) para
# tener consistencia de modelos y sin los límites de cuota del tier
# gratuito. En el tier pagado, a diferencia del gratuito, Google no usa tus
# prompts/respuestas para entrenar sus productos.
LLM_MODEL_PRIMARY=gemini-3.1-pro-preview
LLM_MODEL_FALLBACK=gemini-3.6-flash
TEMPERATURE=0

# --- Reintentos ante errores transitorios de la API (ver src/llm.py) ---
# Calibrado para cuenta CON CRÉDITOS -- sin los límites del tier gratuito no
# hay razón para ser conservador. Ver comentario en src/config.py.
MAX_REINTENTOS_TRANSITORIO=5
BACKOFF_INICIAL=2.0
BACKOFF_MAX=30.0
BACKOFF_JITTER=0.25
MAX_REINTENTOS_CUOTA_MINUTO=3
TIMEOUT_SOLICITUD_SEG=300

# --- Umbrales de decisión ---
CONFIDENCE_THRESHOLD=0.70
AUTO_PROMOTE=0.90

# --- Cotas del agente (usadas por el agente Plan-and-Execute de referencia) ---
MAX_PLAN_STEPS=6
MAX_TOOL_ITERS=8
MAX_REPLANS=1
MAX_INTENTOS_CORRECCION=2

# --- Reputación de IPs ---
SCORE_MALICIOSO=75
SCORE_SOSPECHOSO=25
IP_CACHE_PATH=./data/ip_reputation_cache.json

# --- Memoria (ChromaDB) ---
TOP_K_FEWSHOT=3
TOP_K_ERRORS=3
SIMILARITY_FLOOR=0.55
MAX_RAW_CHARS_EMBED=2000
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma
