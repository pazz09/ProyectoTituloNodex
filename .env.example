# Copiar este archivo a ".env" y completar con las keys reales.
# NUNCA subir el archivo ".env" real a git.

# --- API keys ---

# Gemini — https://aistudio.google.com/apikey (obligatoria)
GEMINI_API_KEY=

# AbuseIPDB (reputación de IPs) — https://www.abuseipdb.com/register
# Opcional: sin key, la reputación usa un fallback heurístico local.
ABUSEIPDB_API_KEY=

# NVD (consulta de CVEs) — https://nvd.nist.gov/developers/request-an-api-key
# Opcional: funciona sin key pero con un límite de tasa muy bajo.
NVD_API_KEY=

# --- Modelo de lenguaje ---
# El sistema llama primero al principal; si agota sus reintentos por cuota o
# un error transitorio, reintenta automáticamente con el de respaldo antes
# de darse por vencido (ver `_generate_con_fallback` en src/llm.py).
LLM_MODEL_PRIMARY=gemini-3.1-pro-preview
LLM_MODEL_FALLBACK=gemini-3.6-flash
TEMPERATURE=0

# --- Reintentos ante errores transitorios de la API ---
MAX_REINTENTOS_TRANSITORIO=5
BACKOFF_INICIAL=2.0
BACKOFF_MAX=30.0
BACKOFF_JITTER=0.25
MAX_REINTENTOS_CUOTA_MINUTO=3
TIMEOUT_SOLICITUD_SEG=300

# --- Umbrales de decisión ---
CONFIDENCE_THRESHOLD=0.70
AUTO_PROMOTE=0.90

# --- Plan-and-Execute (agente_planificador, router_finalizacion) ---
MAX_PLAN_STEPS=6
MAX_REPLANS=1

# --- Ciclo de corrección de comandos de mitigación ---
MAX_INTENTOS_CORRECCION=2

# --- Reputación de IPs (categorización por score AbuseIPDB 0..100) ---
SCORE_MALICIOSO=75
SCORE_SOSPECHOSO=25
IP_CACHE_PATH=./data/ip_reputation_cache.json

# --- Acotamiento del prompt del Triage por cantidad de IPs distintas ---
TOP_N_IPS_PROMPT=20

# --- Tope de caracteres del contexto de preprocesamiento en el prompt del
# Triage (esquema, decoders, severidades, categorías, cobertura, muestras) ---
CONTEXTO_PREPROCESAMIENTO_MAX_CHARS=2000

# --- Memoria de largo plazo (ChromaDB) ---
TOP_K_FEWSHOT=3
TOP_K_ERRORS=3
SIMILARITY_FLOOR=0.55
MAX_RAW_CHARS_EMBED=2000
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma

# --- Integración MITRE ATT&CK (STIX 2.1) ---
TOP_K_ATTACK=3
SIMILARITY_FLOOR_ATTACK=0.42
ATTACK_MAX_CHARS_EMBED=800
MITRE_ATTACK_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json

# --- Preprocesamiento heterogéneo de logs ---
# LOG_PARSING_MODE: batch | chunked | line | hybrid (recomendado)
#   batch   -- un decoder dominante para todo el lote
#   chunked -- un decoder por bloque de LOG_DETECTION_CHUNK_SIZE registros
#   line    -- detección independiente por registro (el más lento)
#   hybrid  -- bloques, reprocesando individualmente los registros que el
#              dominante no explica bien
# En modo hybrid, LOG_LINE_FALLBACK_THRESHOLD debe ser MAYOR que
# LOG_FORMAT_CONFIDENCE_THRESHOLD; si no, la validación lo rechaza.
LOG_PARSING_MODE=hybrid
LOG_DETECTION_CHUNK_SIZE=50
LOG_FORMAT_CONFIDENCE_THRESHOLD=0.50
LOG_LINE_FALLBACK_THRESHOLD=0.70

LOG_ENABLE_MULTILINE=true
# Controla la PERSISTENCIA (historial.db) y la EXPORTACIÓN (PDF) del raw --
# NO lo que se envía al LLM (las muestras del prompt del Triage no pasan
# por acá). Con false: la cronología persistida usa el evento decodificado
# y enmascara IPs/usuarios/hosts; en su lugar se guarda un hash SHA-256,
# líneas y tamaño del lote. Ver el comentario en src/config.py.
LOG_PRESERVE_RAW=true
LOG_MAX_RAW_SAMPLES=20
LOG_MAX_UNMAPPED_FIELDS=100

LOG_NORMALIZATION_SCHEMA_VERSION=2.0
CRONOLOGIA_MAX_EVENTOS=40
LOG_MAX_FILE_BYTES=52428800
LOG_MAX_EVENTS=100000
